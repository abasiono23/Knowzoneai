NODE_ENV=development
PORT=4000
# `npm run db:start` serves Postgres on 5433; docker compose (repo root) uses 5432.
DATABASE_URL=postgresql://knowzone:knowzone@localhost:5433/knowzone_local
# Supabase project URL. The API verifies Supabase Auth tokens with the project's public keys.
SUPABASE_URL=https://your-project.supabase.co
# Optional, server only (never in the app): lets the API delete Supabase sign-ins when accounts are purged.
SUPABASE_SECRET_KEY=
CORS_ORIGIN=*
APP_URL=https://knowzone.ai

# Optional in development. Without it, AI endpoints answer 503 "not-configured".
OPENAI_API_KEY=
OPENAI_MODEL_GENERATE=gpt-5-mini
OPENAI_MODEL_TUTOR=gpt-5-mini
# Diagrams the tutor draws (1 AI credit each)
OPENAI_MODEL_IMAGE=gpt-image-1-mini
# Video narration
OPENAI_MODEL_TTS=gpt-4o-mini-tts
# Course videos (YouTube Data API v3): find and recheck them
YOUTUBE_API_KEY=

# Data-export and deletion emails (sign-up/reset codes are sent by Supabase). Required in production.
RESEND_API_KEY=
EMAIL_FROM=Knowzone <hello@knowzone.ai>


# Payments (Flutterwave dashboard → Settings → API keys). Test keys first (FLWSECK_TEST-…).
# Set the webhook URL in Flutterwave to https://<your API>/webhooks/flutterwave, with a secret hash
# of your choice, and put the same hash here.
FLW_SECRET_KEY=
FLW_SECRET_HASH=

# Help and safety: new support requests, reports and copyright notices are emailed here (optional).
SUPPORT_EMAIL=
