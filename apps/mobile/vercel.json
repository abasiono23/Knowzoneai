{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx expo export --platform web && node scripts/web-site.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(features|pricing|about|blog|faq|post|post-ask-ai|post-exam-day|post-how-to-revise)",
      "destination": "/$1.html"
    },
    {
      "source": "/((?!_expo/|assets/|site/|favicon|practice-questions|study-notes|textbooks|course-guides).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/_expo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
